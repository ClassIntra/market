{
  "name": "web-proxy",
  "type": "plugin",
  "version": "1.0.8",
  "label": "网页代理",
  "category": "hidden",
  "order": 98,
  "defaultEnabled": true,
  "canDisable": true,
  "description": "内置网页代理服务（纯 Node 实现，无需 Python/mitmproxy）。把任意外网站点经本地代理转发并重写资源链接，使超能岛浏览器可以打开被防盗链、跨域或 iframe 限制的站点。代理默认随 ClassIntra 启动自动运行（默认监听 9005，占用自动顺延），管理员可在应用市场「服务端插件」中随时暂停或恢复。",
  "backend": {
    "mountPath": "/api/web-proxy",
    "entry": "./backend/routes.js"
  },
  "integration": {
    "contract": "./shared/contract.js",
    "frontendBridge": "./frontend/bridge.js",
    "clientEntry": "client/src/integrations/web-proxy-client.js",
    "protocolVersion": "1.0",
    "channels": [
      "handshake",
      "proxy-enable",
      "proxy-disable",
      "proxy-status",
      "url-rewrite",
      "page-info",
      "ping"
    ]
  }
}
