{
  "name": "chess",
  "type": "app",
  "version": "1.7.0",
  "sdk": "1",
  "label": "象棋",
  "description": "支持房间联机、人机练习（简单/普通/困难三档棋力，极大极小+a-b 迭代加深）、房间快捷聊天（侧栏双页切换：房间信息/聊天，玩家与观战者均可发言，消息随房间销毁）、观战与替补递补、换方、分享邀请到聊天/社区、服务端走子校验、悔棋认输、本地双人同屏与断线恢复的中国象棋",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#b91c1c",
  "category": "desktop",
  "order": 21,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "system.clipboard",
    "system.share",
    "system.navigate",
    "ui.modal"
  ],
  "frontend": {
    "route": "/chess",
    "routeName": "Chess",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "layout": {
    "mode": "fullscreen",
    "navbar": "custom"
  },
  "backend": {
    "mountPath": "/api/chess",
    "entry": "./backend/routes.js"
  }
}
