{
  "name": "gomoku",
  "type": "app",
  "version": "1.8.1",
  "sdk": "1",
  "label": "五子棋",
  "description": "支持房间联机、跨班对局、房间快捷聊天、本地双人对战、人机练习、观战与断线恢复的原生 DOM 五子棋",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#2563eb",
  "category": "desktop",
  "order": 20,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "system.clipboard",
    "system.share",
    "system.navigate",
    "ui.modal"
  ],
  "frontend": {
    "route": "/gomoku",
    "routeName": "Gomoku",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "layout": {
    "mode": "fullscreen",
    "navbar": "custom"
  },
  "backend": {
    "mountPath": "/api/gomoku",
    "entry": "./backend/routes.js"
  }
}
