{
  "name": "shiguang",
  "type": "app",
  "version": "3.0.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界：走动、捡星屑、点灯柱驱散共享迷雾，天光随全班进度推进。v2 新增表情动作、种光花（全班共建花海）、码头钓星（10 种星鱼图鉴）、流星雨全服事件、任务与成就、拾光衣柜（帽子/提灯/称号）、小地图与拾光明信片。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
