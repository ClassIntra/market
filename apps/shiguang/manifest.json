{
  "name": "shiguang",
  "type": "app",
  "version": "4.1.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界。v4.1「作物」：光花从装饰变成真正的作物 —— 2 星屑种下，3 分钟成熟（浇一次水提早 40 秒，最多三次），收成 8 星屑；帮别人浇过水的人也能分到一点。星屑第一次有了「生产」而不只是「捡」，点灯的钱终于有了来源。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
