{
  "name": "shiguang",
  "type": "app",
  "version": "5.6.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同在一片开放大世界里冒险：白天种田、钓鱼、下矿、走亲访友；入夜后长夜从雾里涌出来，大家回到灯边一起守夜。俯视角像素动作 RPG 遇上成熟农场经营：28 天一季的日历与天气、33 种作物与品质、体力与五级农具、出货箱次日结算、五级技能与职业、畜牧、绿条钓鱼、120 层矿洞、社区中心献祭、村民好感与结婚；外加四坡屋顶的小镇、四栋同一图层的房子、好友羁绊与六种双人互动。代码、美术、文案全部自研，玩法机制与数值对齐经典农场经营游戏。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/v5/routes.js"
  }
}
