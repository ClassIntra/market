{
  "name": "shiguang",
  "type": "app",
  "version": "4.2.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界。v4.2「种子」：12 种作物分三档 —— 星苔 2 星屑 1 分钟回本，长夜葵 220 星屑挂两小时收 1100。按「种花」打开种子面板选种，浇水让成熟提早（别人也能帮你浇，收成时他分一份）。星屑第一次有了真正的生产链，点灯的钱从此有着落。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
