{
  "name": "shiguang",
  "type": "app",
  "version": "4.11.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界。v4.3「手感」：走过光点就自动捡起来，不用再停下来按按钮；连击到 8 会短暂加速；草地会随风起伏，萤火虫贴着草面飘 —— 世界不再是张静止的图。 v4.4「星露谷的一天」：一天 6 分钟，全班同住一个日历；一天浇一瓢水、隔夜长一节、浇了才长 —— 「明天再来」就是这个游戏的心跳。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage",
    "economy.wallet"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
