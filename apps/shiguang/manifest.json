{
  "name": "shiguang",
  "type": "app",
  "version": "4.0.2",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界。v4.0「灯火」：你手里的火就是命 —— 走路会烧、站着也会暗，火弱了视野缩成一圈、雾灵从黑暗里围上来；点亮灯柱要烧掉自己的火，但那盏灯整片云海都看得见，也替别人挡雾。全班把灯点到 10/30/60/100 根，天光就往前推一档：长夜 → 晨光初现 → 云开见月 → 群星归位 → 拾光之海。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
