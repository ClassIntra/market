{
  "name": "shiguang",
  "type": "app",
  "version": "5.0.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同在一片开放大世界里冒险。白天探索、打怪、攒材料；入夜后长夜从雾里涌出来，大家回到灯边一起守夜。v5「长夜」= 俯视角像素动作 RPG：三段连击、翻滚无敌帧与完美闪避的子弹时间、怪物出招前的红色预警、六片区域各有一位守护者 —— 打倒它，灯塔亮起，全班的世界一起变亮。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/v5/routes.js"
  }
}
