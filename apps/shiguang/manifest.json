{
  "name": "shiguang",
  "type": "app",
  "version": "3.1.0",
  "sdk": "1",
  "label": "拾光群岛",
  "description": "全班同处一片云海群岛的多人小世界：走动、捡星屑、点灯柱驱散共享迷雾，天光随全班进度推进。v3.1：岛上的居民有了记忆 —— 走近就开口，第一句话就说得出「上一个来的人叫什么、在哪儿停过」。灯柱升起九格高的光柱，隔着雾也能看见别人的灯。",
  "author": "ClassIntra",
  "icon": "./icon.svg",
  "color": "#5b9bd5",
  "category": "desktop",
  "order": 30,
  "defaultEnabled": true,
  "canDisable": true,
  "capabilities": [
    "data.http",
    "data.realtime",
    "data.storage"
  ],
  "visibleRoles": [
    "classAdmin",
    "admin",
    "officer",
    "student"
  ],
  "layout": {
    "mode": "fullscreen"
  },
  "frontend": {
    "route": "/shiguang",
    "routeName": "Shiguang",
    "entry": "./frontend/entry.js",
    "style": "./frontend/style.css"
  },
  "backend": {
    "mountPath": "/api/shiguang",
    "entry": "./backend/routes.js"
  }
}
