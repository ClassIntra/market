# 依赖
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# 环境变量（示例文件除外）
**/.env
!**/.env.example

# 日志与数据库
*.log
*.db
*.db-shm
*.db-wal

# 象棋人机引擎二进制（Pikafish，GPL-3，约 57MB）：
# 供应商二进制不进公开仓，也不随市场包分发；各机器用主仓
# `node scripts/chess-engine-setup.mjs` 装一次即可（详见 apps/chess/backend/engine/README.md）。
apps/*/backend/engine/*.exe
apps/*/backend/engine/*.nnue

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
*.swp
